# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/tmp/
/output/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Artefatos de build do Gradle
/android/build/
/android/.gradle/

# Flutter SDK local (mantido dentro do projeto por causa da politica AppLocker
# desta maquina, que bloqueia scripts .bat fora de C:\app\Ficha_DnD).
/.flutter-sdk/

# Rascunhos da raiz do projeto.
#
# Rodar analyze, teste e build nesta maquina exige script .cmd na raiz que
# redireciona a saida para arquivo, porque o terminal integrado corta o texto.
# Esses scripts e as saidas deles sao descartaveis, e ficavam aparecendo no
# `git status` misturados com alteracao de verdade.
/_*.cmd
/_*.txt
/_*.png
/_*.bin

# Capturas de tela e APK gerados para teste manual.
/shot*.png
/flutter_*.png
/*.apk

# Ficha exportada em PDF durante teste.
/ficha-*.pdf
