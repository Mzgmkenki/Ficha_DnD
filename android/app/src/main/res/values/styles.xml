<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- O app tem um tema só, preto e vermelho, então a janela nativa também
         é escura mesmo quando o sistema está no modo claro: antes o
         Theme.Light do template dava um flash branco na abertura. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Fundo mostrado enquanto o processo sobe. Some sozinho quando o
             Flutter desenha o primeiro quadro. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Aplicado assim que o processo inicia, e também fica atrás da UI do
         Flutter enquanto ela roda. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
